<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>ru.tarkovskiy</groupId>
        <artifactId>task-manager-autotests</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>api-tests</artifactId>

    <properties>
        <allure.latest.api.input>${maven.multiModuleProjectDirectory}/test-runs/NO_COMPLETED_API_RUN</allure.latest.api.input>
        <allure.latest.api.output>${maven.multiModuleProjectDirectory}/test-runs/NO_COMPLETED_API_RUN/view</allure.latest.api.output>
        <allure.latest.api.runId>No completed api run</allure.latest.api.runId>
        <allure.latest.api.order>0</allure.latest.api.order>
        <allure.maven.input>${allure.latest.api.input}</allure.maven.input>
        <allure.maven.output>${allure.latest.api.output}</allure.maven.output>
        <allure.maven.runId>${allure.latest.api.runId}</allure.maven.runId>
        <allure.maven.buildOrder>${allure.latest.api.order}</allure.maven.buildOrder>
    </properties>

    <dependencies>
        <!-- REST Assured для API-тестирования -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.18.2</version>
            <scope>test</scope>
        </dependency>

        <!-- TestNG для запуска тестов -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Allure для отчётов -->
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-testng</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.7</version>
            <scope>test</scope>
        </dependency>

        <!-- Проверка JSON Schema -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>5.5.0</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>2.18.2</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build><plugins><plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>build-helper-maven-plugin</artifactId><version>3.3.0</version>
        <executions><execution><id>shared-reporting</id><phase>generate-test-sources</phase>
            <goals><goal>add-test-source</goal></goals><configuration><sources>
                <source>${project.basedir}/../reporting/src/main/java</source>
            </sources></configuration>
        </execution></executions>
    </plugin></plugins></build>
</project>