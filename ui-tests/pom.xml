<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>ru.tarkovskiy</groupId>
        <artifactId>task-manager-autotests</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>ui-tests</artifactId>


    <properties>
        <allure.latest.ui.input>${maven.multiModuleProjectDirectory}/test-runs/NO_COMPLETED_UI_RUN</allure.latest.ui.input>
        <allure.latest.ui.output>${maven.multiModuleProjectDirectory}/test-runs/NO_COMPLETED_UI_RUN/view</allure.latest.ui.output>
        <allure.latest.ui.runId>No completed ui run</allure.latest.ui.runId>
        <allure.latest.ui.order>0</allure.latest.ui.order>
        <allure.maven.input>${allure.latest.ui.input}</allure.maven.input>
        <allure.maven.output>${allure.latest.ui.output}</allure.maven.output>
        <allure.maven.runId>${allure.latest.ui.runId}</allure.maven.runId>
        <allure.maven.buildOrder>${allure.latest.ui.order}</allure.maven.buildOrder>
    </properties>

    <dependencies>
        <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId><version>2.18.2</version><scope>test</scope></dependency>
        <!-- Selenium WebDriver для UI-тестов -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- TestNG для запуска тестов -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Allure для отчётов -->
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-testng</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- PostgreSQL JDBC для проверки и очистки тестовых данных -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.7</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build><plugins><plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>build-helper-maven-plugin</artifactId><version>3.3.0</version>
        <executions><execution><id>shared-reporting</id><phase>generate-test-sources</phase>
            <goals><goal>add-test-source</goal></goals><configuration><sources>
                <source>${project.basedir}/../reporting/src/main/java</source>
            </sources></configuration>
        </execution></executions>
    </plugin></plugins></build>
</project>